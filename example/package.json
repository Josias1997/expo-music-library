{
  "name": "example",
  "version": "1.0.0",
  "main": "index.js",
  "scripts": {
    "start": "expo start --dev-client",
    "prebuild:android": "expo prebuild --clean --no-install --platform android",
    "prebuild:ios": "expo prebuild --clean --no-install --platform ios",
    "postprebuild:ios": "node scripts/ensure-ios-rct-bridge.cjs",
    "typecheck": "tsc --noEmit",
    "android": "expo run:android",
    "ios": "expo run:ios",
    "web": "expo start --web"
  },
  "dependencies": {
    "expo": "~57.0.8",
    "expo-music-library": "file:..",
    "expo-status-bar": "~57.0.1",
    "react": "19.2.3",
    "react-native": "0.86.0"
  },
  "devDependencies": {
    "@babel/core": "^8.0.1",
    "@types/react": "~19.2.17",
    "typescript": "~6.0.3"
  },
  "private": true
}
